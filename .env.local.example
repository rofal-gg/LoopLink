# LoopLink — Template Environment Variables
# Salin file ini menjadi .env.local, lalu isi nilainya secara manual:
#   cp .env.local.example .env.local
# JANGAN commit .env.local ke git (sudah di-ignore).

# ===== Supabase =====
# Dapatkan dari dashboard Supabase -> Project Settings -> API
# (URL & key yang bisa dipakai publik, aman ditampilkan di browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kunci service role — HANYA dipakai di sisi server (API route / RPC).
# JANGAN pernah ekspos ke browser (tidak boleh pakai prefix NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=

# ===== Klasifikasi Citra — HuggingFace Space (watersplash/waste-classification) =====
# Model klasifikasi citra LoopLink di-deploy sebagai HF Space (Gradio SDK +
# ZeroGPU) dengan endpoint POST /klasifikasi. Dua env berikut WAJIB diisi:
#   KLASIFIKASI_API_URL   → URL Space, format https://<space>-<username>.hf.space
#                           (mis. https://looplink-waste-classifier-owner.hf.space).
#                           Endpoint klasifikasi otomatis = URL tersebut + /klasifikasi.
#   KLASIFIKASI_API_TOKEN → nilai yang SAMA dengan Secret `API_KEY` yang di-set
#                           di pengaturan Space (Settings → Variables and secrets).
#                           Dikirim sebagai header X-API-KEY ke Space.
# HF_API_TOKEN TIDAK lagi dibutuhkan untuk klasifikasi (sebelumnya dipakai untuk
# memanggil HF Inference Router google/vit-base-patch16-224).
KLASIFIKASI_API_URL=
KLASIFIKASI_API_TOKEN=

# ===== Google AI Studio — Gemini 1.5 Flash =====
# Buat API key di https://aistudio.google.com/apikey
GEMINI_API_KEY=
